---
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  style?: 'standard' | 'csh-illustrated';
}

const {
  src,
  alt,
  width,
  height,
  style = 'standard',
} = Astro.props;
---

<section class:list={['article-hero', { 'article-hero--illustrated': style === 'csh-illustrated' }]}>
  <div class="wrap-content">
    <div class="article-hero__frame">
      <img src={src} alt={alt} width={width} height={height} />
      {style === 'csh-illustrated' && (
        <>
          <div class="article-hero__grid" aria-hidden="true"></div>
          <div class="article-hero__sweep" aria-hidden="true"></div>
          <div class="article-hero__registration" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>
          <div class="article-hero__label" aria-hidden="true">
            <span>CSH field notes</span>
            <span>Independent review</span>
          </div>
        </>
      )}
    </div>
  </div>
</section>

<style>
  .article-hero {
    padding: 36px 28px;
    border-bottom: 1.5px solid var(--ink);
    background: var(--paper-deep);
  }
  .article-hero__frame {
    position: relative;
    overflow: hidden;
    border: 1.5px solid var(--ink);
    background: var(--ink);
    isolation: isolate;
  }
  .article-hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .article-hero--illustrated .article-hero__frame {
    box-shadow: 8px 8px 0 var(--orange);
  }
  .article-hero--illustrated img {
    filter: saturate(.9) contrast(1.04);
    transform: scale(1.012);
    animation: csh-hero-drift 16s ease-in-out infinite alternate;
  }
  .article-hero__grid,
  .article-hero__sweep,
  .article-hero__registration,
  .article-hero__label {
    pointer-events: none;
    position: absolute;
    z-index: 2;
  }
  .article-hero__grid {
    inset: 0;
    opacity: .2;
    mix-blend-mode: screen;
    background-image:
      linear-gradient(rgba(243,239,230,.36) 1px, transparent 1px),
      linear-gradient(90deg, rgba(243,239,230,.36) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(90deg, #000, transparent 70%);
  }
  .article-hero__sweep {
    top: -60%;
    bottom: -60%;
    left: -24%;
    width: 18%;
    background: linear-gradient(90deg, transparent, rgba(232,90,31,.38), transparent);
    transform: rotate(12deg);
    animation: csh-hero-sweep 9s ease-in-out infinite;
  }
  .article-hero__registration {
    inset: 18px;
  }
  .article-hero__registration span {
    position: absolute;
    width: 22px;
    height: 22px;
    border-color: var(--paper);
    border-style: solid;
    opacity: .9;
  }
  .article-hero__registration span:nth-child(1) { top: 0; left: 0; border-width: 2px 0 0 2px; }
  .article-hero__registration span:nth-child(2) { top: 0; right: 0; border-width: 2px 2px 0 0; }
  .article-hero__registration span:nth-child(3) { bottom: 0; left: 0; border-width: 0 0 2px 2px; }
  .article-hero__registration span:nth-child(4) { right: 0; bottom: 0; border-width: 0 2px 2px 0; }
  .article-hero__label {
    right: 18px;
    bottom: 18px;
    display: flex;
    gap: 8px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  .article-hero__label span {
    padding: 6px 9px;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid rgba(243,239,230,.45);
  }
  .article-hero__label span:first-child {
    background: var(--orange);
    color: var(--ink);
    border-color: var(--orange);
    font-weight: 700;
  }
  @keyframes csh-hero-drift {
    from { transform: scale(1.012) translate3d(-.25%, 0, 0); }
    to { transform: scale(1.035) translate3d(.35%, -.25%, 0); }
  }
  @keyframes csh-hero-sweep {
    0%, 18% { transform: translateX(0) rotate(12deg); opacity: 0; }
    28% { opacity: 1; }
    58%, 100% { transform: translateX(760%) rotate(12deg); opacity: 0; }
  }
  @media (max-width: 767px) {
    .article-hero { padding: 24px 20px 28px; }
    .article-hero--illustrated .article-hero__frame { box-shadow: 5px 5px 0 var(--orange); }
    .article-hero__grid { background-size: 32px 32px; }
    .article-hero__label { right: 10px; bottom: 10px; }
    .article-hero__label span:last-child { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .article-hero--illustrated img,
    .article-hero__sweep { animation: none; }
    .article-hero__sweep { display: none; }
  }
</style>
